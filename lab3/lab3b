#include "xil_printf.h"
#include "xparameters.h"
#include "xuartlite.h"

#include <stdio.h>
#include <stdlib.h>

#include "PmodKYPD.h"
#include "sleep.h"

#define ROCK 1
#define PAPER 2
#define SCISSORS 3

const char *moves[] = {
    "",
    "rock",
    "paper",
    "scissors"
};

#define DEFAULT_KEYTABLE "0FED789C456B123A"

// get player 2 input from keypad
int GetKeypadMove(PmodKYPD *keypad)
{
	u16 keystate;
	XStatus status;
	u8 key;

	XStatus last_status = KYPD_NO_KEY;
	u8 last_key = 'x';

	while (1)
	{
		// capture keypad state
		keystate = KYPD_getKeyStates(keypad);

		// determine which key is pressed
		status = KYPD_getKeyPressed(keypad, keystate, &key);

		// check for a newly pressed key
		if (status == KYPD_SINGLE_KEY &&
			(status != last_status || key != last_key))
		{
			// only accept keys 1, 2, and 3
			if (key >= '1' && key <= '3')
			{
				xil_printf("%c\r\n", (char)key);

				return key - '0';
			}
			else
			{
				xil_printf("\r\nInvalid key! Press 1, 2, or 3.\r\n");
			}

			last_key = key;
		}

		last_status = status;

		// small delay between scans
		usleep(1000);
	}

}

// read player 1 input from UART
int GetUARTMove(XUartLite *uart)
{
    char c;
    int received;

    while (1)
    {
        received = XUartLite_Recv(uart, (u8 *)&c, 1);

        if (received == 1)
        {
            if (c >= '1' && c <= '3')
            {
                xil_printf("%c\r\n", c);
                return c - '0';
            }
            else if (c == '\r' || c == '\n')
            {
                continue;
            }
            else
            {
                xil_printf("\r\nInvalid input! Enter 1, 2, or 3: ");
            }
        }
    }
}

// determine winner
void DetermineWinner(int player1, int player2)
{
    xil_printf("\r\n--------------------------------\r\n");

    xil_printf("PC selected: %s\r\n", moves[player1]);
    xil_printf("FPGA selected: %s\r\n", moves[player2]);

    if (player1 == player2)
    {
        xil_printf("It's a tie! %s = %s\r\n",
                   moves[player1], moves[player2]);
    }
    else if ((player2 == ROCK && player1 == SCISSORS) ||
             (player2 == PAPER && player1 == ROCK) ||
             (player2 == SCISSORS && player1 == PAPER))
    {
        xil_printf("FPGA won! %s > %s\r\n",
                   moves[player2], moves[player1]);
    }
    else
    {
        xil_printf("PC won! %s > %s\r\n",
                   moves[player1], moves[player2]);
    }

    xil_printf("--------------------------------\r\n");
}


int main()
{
	PmodKYPD myDevice;
    XUartLite uart;

    int player1;
    int player2;

    // initialize keypad
    KYPD_begin(&myDevice, XPAR_PMODKYPD_0_AXI_LITE_GPIO_BASEADDR);
    KYPD_loadKeyTable(&myDevice, (u8*) DEFAULT_KEYTABLE);

    // initialize keypad GPIO
    Xil_Out32(myDevice.GPIO_addr, 0xF);

    // initialize UART
    XUartLite_Initialize(&uart, XPAR_UARTLITE_0_DEVICE_ID);

    xil_printf("\r\n");
    xil_printf("================================\r\n");
    xil_printf("    ROCK PAPER SCISSORS GAME    \r\n");
    xil_printf("================================\r\n");

    xil_printf("1 = Rock\r\n");
    xil_printf("2 = Paper\r\n");
    xil_printf("3 = Scissors\r\n");

    while (1)
    {
        xil_printf("\r\n========== NEW ROUND ==========\r\n");

        // Player 1: PC Terminal
        xil_printf("\r\nPC Player - Enter your move (1-3): ");

        player1 = GetUARTMove(&uart);

        // Player 2: Keypad
        xil_printf("\r\nFPGA Player - Enter your move "
                   "using the keypad (1-3): ");

        player2 = GetKeypadMove(&myDevice);

        xil_printf("%d\r\n", player2);

        // determine winner
        DetermineWinner(player1, player2);
    }


    return 0;
}
