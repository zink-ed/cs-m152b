// read player 1 input from UART
int GetUARTMove(XUartLite *uart)
{
    char c;
    int received;

    while (1)
    {
        received = XUartLite_Recv(uart, (u8 *)&c, 1);

        if (received == 1)
        {
            if (c >= '1' && c <= '3')
            {
                xil_printf("%c\r\n", c);
                return c - '0';
            }
            else if (c == '\r' || c == '\n')
            {
                continue;
            }
            else
            {
                xil_printf("\r\nInvalid input! Enter 1, 2, or 3: ");
            }
        }
    }
}

// determine winner
void DetermineWinner(int player1, int player2)
{
    xil_printf("\r\n--------------------------------\r\n");

    xil_printf("PC selected: %s\r\n", moves[player1]);
    xil_printf("FPGA selected: %s\r\n", moves[player2]);

    if (player1 == player2)
    {
        xil_printf("It's a tie! %s = %s\r\n",
                   moves[player1], moves[player2]);
    }
    else if ((player2 == ROCK && player1 == SCISSORS) ||
             (player2 == PAPER && player1 == ROCK) ||
             (player2 == SCISSORS && player1 == PAPER))
    {
        xil_printf("FPGA won! %s > %s\r\n",
                   moves[player2], moves[player1]);
    }
    else
    {
        xil_printf("PC won! %s > %s\r\n",
                   moves[player1], moves[player2]);
    }

    xil_printf("--------------------------------\r\n");
}


